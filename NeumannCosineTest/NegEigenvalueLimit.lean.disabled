import NeumannCosine.Discrete.Eigenvalues

/-! Negative control: the discrete eigenvalues converge to `(nπ/L)²`, not to `nπ/L`.
Mutation of `discreteNeumannEigenvalue_tendsto`: the square dropped from the limit. Must not compile. -/

open Filter Topology NeumannCosine.Discrete.Eigenvalues

example (L : ℝ) (n : ℕ) (hL : 0 < L) (hn : 0 < n) :
    Tendsto (fun N : ℕ =>
        4 / (L / (N : ℝ)) ^ 2 * Real.sin ((n : ℝ) * Real.pi / (2 * (N : ℝ))) ^ 2)
      atTop (𝓝 ((n : ℝ) * Real.pi / L)) := by
  exact discreteNeumannEigenvalue_tendsto L n hL hn
